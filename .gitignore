/vibe-kit/kit/secrets.json
/vibe-kit/kit/gitlab.json
/vibe-kit/kit/config.json
/vibe-kit/kit/local.json
/vibe-kit/kit/installed.json
/vibe-kit/kit/drivers.json
/vibe-kit/kit/state/
/vibe-kit/kit/feedback/
