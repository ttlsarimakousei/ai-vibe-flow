{
  "name": "B 表单向导：校验提示 + 三步提交",
  "steps": [
    { "goto": "/login.html" },
    { "fill": "#username", "value": "admin" },
    { "fill": "#password", "value": "admin123" },
    { "click": "text=登录" },
    { "waitUrl": "**/dashboard.html*" },
    { "goto": "/b/index.html" },
    { "wait": "#name" },
    { "click": "#next1", "note": "什么都不填直接下一步，应提示名称不能为空" },
    { "read": "#err1", "as": "emptyError" },
    { "fill": "#name", "value": "华兴电子" },
    { "select": "#type", "value": "代理商" },
    { "check": "#region3" },
    { "fill": "#email", "value": "test@", "note": "故意写错的邮箱" },
    { "click": "#next1" },
    { "read": "#err1", "as": "emailError" },
    { "fill": "#email", "value": "hx@example.com" },
    { "click": "#next1" },
    { "wait": "#contact" },
    { "fill": "#contact", "value": "周明" },
    { "fill": "#phone", "value": "13800000000" },
    { "fill": "#remark", "value": "体检测试" },
    { "click": "#next2" },
    { "wait": "#submit" },
    { "expectText": "华兴电子" },
    { "click": "#submit" },
    { "waitText": "提交成功" },
    { "read": "#code", "as": "code" },
    { "read": "#doneName", "as": "doneName" },
    { "screenshot": "done" },
    { "expectNoConsoleErrors": true }
  ]
}
